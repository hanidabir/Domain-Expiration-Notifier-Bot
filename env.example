TELEGRAM_BOT_TOKEN=
WHOAPI_KEY=

# SMTP required for email alerts; may be left blank while testing Telegram only
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=domains@example.com
SMTP_USE_TLS=true

# Optional
# DB_PATH=./domains.sqlite3
WARNING_DAYS=30
LOG_LEVEL=INFO
